{
  "name": "@pr0hub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^10.1.7",
    "@pr0hub/core": "workspace:*",
    "@pr0hub/flight": "workspace:*",
    "@pr0hub/loot": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.1.0",
    "web-push": "^3.6.7",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.19.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "migrations",
    "openapi.yaml"
